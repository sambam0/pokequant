<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pokequant.telegram-poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/REPLACE/Poke/deploy/mini/telegram-poll.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE/Poke</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/REPLACE/Poke/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>Europe/Stockholm</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE/Poke/data/hermes/logs/telegram-poll.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE/Poke/data/hermes/logs/telegram-poll.err</string>
</dict>
</plist>
